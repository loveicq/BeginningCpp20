{
    "files.associations": {
        "*.cppm": "cpp",
        "*.ixx": "cpp",
        "*.mpp": "cpp",
        "bitset": "cpp",
        "string_view": "cpp",
        "rope": "cpp",
        "regex": "cpp"
    },
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.compilerPath": "D:/msys64/ucrt64/bin/g++.exe",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.compilerArgs": [
        "-std=c++20",
        "-fmodules-ts"
    ],
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "C_Cpp.autocompleteAddParentheses": true,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.dimInactiveRegions": false,
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.inactiveRegionOpacity": 1.0,
    "files.exclude": {
        "**/node_modules/**": true,
        "**/*.o": true,
        "**/*.exe": true,
        "**/*.obj": true,
        "**/*.dll": true,
        "**/out/**": true,
        "**/bin/**": true
    },
    "search.exclude": {
        "**/node_modules/**": true,
        "**/.vscode/**": true,
        "**/build/**": true,
        "**/*.o": true,
        "**/*.exe": true
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "keyword.control.import.cpp",
                "settings": {
                    "foreground": "#c678dd",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "keyword.control.module.cpp",
                "settings": {
                    "foreground": "#c678dd",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "keyword.control.export.cpp",
                "settings": {
                    "foreground": "#c678dd",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "keyword.control.CPP.except.export",
                "settings": {
                    "foreground": "#c678dd",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "storage.type.module.cpp",
                "settings": {
                    "foreground": "#e6c07b",
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "files.defaultLanguage": "cpp",
    "editor.semanticHighlighting.enabled": false,
    "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false,
    "workbench.editor.enablePreview": false
}